{
	auto_https off
	admin off
	log default {
		level ERROR
	}
}

http://:8086 {
	bind 127.0.0.1
	root * /srv/it-tools/current/dist
	encode gzip
	header Cache-Control no-cache
	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		-Server
	}
	# Assets absent from this release must be real 404s, not cached SPA HTML.
	handle /assets/* {
		@immutable {
			path_regexp hashed ^/assets/.*-[A-Za-z0-9_-]{8}\.(js|css|wasm|woff2?|ttf|png|svg|jpe?g|webp)$
			file {path}
		}
		header @immutable {
			Cache-Control "public, max-age=31536000, immutable"
			defer
		}
		file_server {
			precompressed br gzip
		}
	}
	# No dynamic authentication endpoint is hosted on 3600.
	handle /api/* {
		header {
			Cache-Control no-store
			defer
		}
		respond "Not found" 404
	}
	handle {
		try_files {path} /index.html
		file_server {
			precompressed br gzip
		}
	}
}
